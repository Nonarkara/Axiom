/**
 * Axiom Framework - ESP32 Sensor Configuration
 * Copy this file to config.h and fill in your credentials.
 * DO NOT commit config.h to version control.
 */

#ifndef CONFIG_H
#define CONFIG_H

// =============================================================================
// WiFi Configuration
// =============================================================================

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// =============================================================================
// MQTT / ThingsBoard Configuration
// =============================================================================

#define MQTT_SERVER "your-server.com"  // Or IP address
#define MQTT_PORT 1883
#define DEVICE_ACCESS_TOKEN "YOUR_THINGSBOARD_DEVICE_TOKEN"

// If using ThingsBoard, the topic is fixed:
#define MQTT_TELEMETRY_TOPIC "v1/devices/me/telemetry"
#define MQTT_ATTRIBUTES_TOPIC "v1/devices/me/attributes"

// =============================================================================
// Sensor Identification
// =============================================================================

#define DEVICE_ID "sikhio_pm25_001"
#define MUNICIPALITY_ID "sikhio"
#define LATITUDE 14.8920
#define LONGITUDE 101.3660
#define DEVICE_NAME "Sikhio Municipality Office"

// =============================================================================
// Sensor Hardware Configuration
// =============================================================================

// PMS5003 PM2.5 sensor UART pins
#define PMS_RX_PIN 16
#define PMS_TX_PIN 17
#define PMS_BAUD 9600

// DHT22 Temperature/Humidity sensor
#define DHT_PIN 4
#define DHT_TYPE 22  // DHT22

// Deep sleep duration (seconds) - longer = more battery life
#define SLEEP_DURATION_SECONDS 60

// Number of measurement samples to average
#define SAMPLE_COUNT 5

// =============================================================================
// Advanced Configuration
// =============================================================================

// Enable serial debug output
#define DEBUG_SERIAL true

// Watchdog timeout (seconds)
#define WDT_TIMEOUT_SECONDS 120

// Retry attempts for WiFi/MQTT connection
#define MAX_CONNECT_RETRIES 10
#define CONNECT_RETRY_DELAY_MS 1000

// LED indicator pin (optional, -1 to disable)
#define LED_PIN 2

#endif // CONFIG_H
