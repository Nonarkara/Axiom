# Axiom Framework - API Poller Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://axiom:your_password@localhost:5432/municipal

# =============================================================================
# MUNICIPALITY
# =============================================================================
# Options: sikhio, yala_city, nakhon_si, kmitl, chula, muang_thong
MUNICIPALITY_ID=sikhio

# =============================================================================
# POLLING INTERVAL (seconds)
# =============================================================================
POLL_INTERVAL=300

# =============================================================================
# DATA SOURCE API KEYS
# =============================================================================

# Get from: https://data.go.th
DATA_GO_TH_API_KEY=your_data_go_th_key_here

# Get from: Bangkok Metropolitan Administration IT Division
BMA_API_KEY=your_bma_key_here

# Get from: https://fondue.in.th (developer section)
TRAFFY_API_KEY=your_traffy_key_here

# Get from: https://aqicn.org/api/
WAQI_TOKEN=your_waqi_token_here

# Get from: https://www.gistda.or.th (for government partners)
GISTDA_TOKEN=your_gistda_token_here

# Get from: https://www.tpmap.in.th
TPMAP_KEY=your_tpmap_key_here
